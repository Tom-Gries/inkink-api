{
  "name": "inkink-api",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "start": "tsx src/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.2",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.2",
    "hono": "^4.13.5",
    "mongodb": "^7.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/node": "^22.10.2",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "latest"
  }
}