# ===== API (Server) =====

# MongoDB-Verbindung (Atlas: mongodb+srv://<user>:<password>@<cluster>/...)
MONGODB_URI=

# Datenbankname (optional, Standard: inkink)
MONGODB_DB=inkink

# Better Auth / Google OAuth (Auth-Endpunkte unter /api/auth/*)
BETTER_AUTH_SECRET=

# Öffentliche URL der App – Produktion: https://<dein-projekt>.vercel.app
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth-Log-Level der API (debug | info | warn | error)
AUTH_LOG_LEVEL=warn

# Zusätzliche vertraute Origins für den Auth-Flow, komma-getrennt.
# Das Dev-Setup (Web :3000 <-> API :8787) wird in src/auth.ts automatisch
# ergänzt – nur bei abweichenden Origins hier setzen.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000