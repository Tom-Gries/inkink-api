# ===== API (Server) =====

# MongoDB-Verbindung (Atlas: mongodb+srv://<user>:<password>@<cluster>/...)
MONGODB_URI=

# Datenbankname (optional, Standard: inkink)
MONGODB_DB=inkink

# Better Auth / Google OAuth (Auth-Endpunkte unter /api/auth/*)
BETTER_AUTH_SECRET=

# Öffentliche URL der App – Produktion: https://<dein-projekt>.vercel.app
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth-Log-Level der API (debug | info | warn | error)
AUTH_LOG_LEVEL=warn

# Vertraute Origins für Better Auth (trustedOrigins) und CORS – komma-separiert.
# Leerzeichen um einzelne Origins werden entfernt, leere Einträge ignoriert.
# Ohne Variable vertraut Better Auth nur der eigenen baseURL (BETTER_AUTH_URL);
# CORS erlaubt dann keine Cross-Origin-Anfragen.
#
# Development (Web :3000 <-> API :8787):
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# Staging/Production (Frontend auf eigener Domain), z. B.:
# TRUSTED_ORIGINS=https://inkink.app,https://www.inkink.app